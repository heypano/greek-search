{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["ES2020"],  // String.prototype.matchAll
    "outDir": "dist",
    "types": [],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ES2020",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Node",
    "declaration": true,
    "declarationDir": "dist"
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts"]
}
